# Copy to .env.local and fill in. Never commit the real values.

# --- Supabase (auth + DB) ---
# Project settings > API. The service role key is server-only: it bypasses RLS,
# so it must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_LOGO_BUCKET=logos

# Leave the Supabase vars unset to run against a local JSON store instead
# (.data/buildings.json) — useful for a first run with no Supabase project yet.

# --- Dodo Payments ---
DODO_PAYMENTS_API_KEY=replace_me
DODO_PAYMENTS_ENVIRONMENT=test_mode
# A one-time product with Pay What You Want pricing enabled and a low minimum;
# every checkout reuses it and overrides the exact amount per purchase.
DODO_PAYMENTS_PRODUCT_ID=pdt_replace_me
# Developer > Webhooks > your endpoint > signing secret
DODO_PAYMENTS_WEBHOOK_KEY=whsec_replace_me

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CHECKOUT_HOLD_MINUTES=15
