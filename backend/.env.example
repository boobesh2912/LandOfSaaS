# --- Dodo Payments (test mode) ---
# Get these from your Dodo Payments dashboard > Developer > API Keys / Webhooks.
# NEVER commit the real values or paste them into chat/PRs — this file only holds placeholders.
DODO_PAYMENTS_API_KEY=sk_test_replace_me
DODO_PAYMENTS_ENVIRONMENT=test_mode
# One-time "Territory Claim" product with Pay-What-You-Want pricing enabled
# (min price ~ $1, no fixed max — the exact amount is set per-checkout from area x rate).
DODO_PAYMENTS_PRODUCT_ID=pdt_replace_me
# Developer > Webhooks > your endpoint > "Signing secret"
DODO_PAYMENTS_WEBHOOK_KEY=whsec_replace_me

# --- App ---
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
# Where Dodo should send the buyer back after checkout
FRONTEND_SUCCESS_URL=http://localhost:5173/claimed
FRONTEND_CANCEL_URL=http://localhost:5173

# Land economy
PRICE_USD_PER_KM2=2.0
CHECKOUT_HOLD_MINUTES=15

DATABASE_URL=sqlite:///./landofsaas.db
